# Скопируйте в .env рядом с docker-compose.frontend.yml и поправьте под себя:
#   cp .env.frontend.example .env

# Внешний порт фронта (любой свободный, кроме занятых)
FRONTEND_PORT=8090

# Адрес шлюза бэкенда.
#  - если фронт в одной сети с бэкендом: http://nginx (имя контейнера-шлюза)
#  - если в разных сетях: http://<ip-или-домен-сервера>:8081
BACKEND_URL=http://nginx

# Реальное имя docker-сети бэкенда (узнать: docker network ls | grep crm)
BACKEND_NETWORK=backend_crm_crm_network
